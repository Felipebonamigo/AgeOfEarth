    "die_helepolis": {
      "loop": false, "ease": "smooth", "keys": [
        {"t": 0, "root": {"pos": [0, 0, 0], "rot": [0, 0, 0]}, "arm": [180, 0, 0], "stone": 1, "collapse": 0},
        {"t": 0.35, "root": {"pos": [0, -0.05, 0], "rot": [-4, 0, 3]}, "arm": [140, 0, 0], "stone": 0, "collapse": 0.3},
        {"t": 1, "root": {"pos": [0, -0.2, 0], "rot": [-9, 0, 6]}, "arm": [100, 0, 0], "stone": 0, "collapse": 1}
      ]
    }
  }
}
