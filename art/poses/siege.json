        {"t": 0.2, "root": {"pos": [0, 0, 0], "rot": [0.5, 0, 0]}, "shutter": [82, 0, 0], "arm": [-6, 0, 0], "stone": 0},
        {"t": 0.5, "shutter": [70, 0, 0], "arm": [90, 0, 0], "stone": 0},
        {"t": 0.75, "shutter": [25, 0, 0], "arm": [180, 0, 0], "stone": 1},
        {"t": 1, "shutter": [0, 0, 0], "arm": [180, 0, 0], "stone": 1}
      ]
